# Chave da RapidAPI para usar a fonte "exercisedb" no script de ingestão de exercícios.
# Veja instruções em README.md > "Base de dados de exercícios".
RAPIDAPI_KEY=

# --- Backend (server/) ---

# String de conexão do Postgres. Local: postgresql://postgres:postgres@localhost:5432/sobrecarga
# Railway: preenchida automaticamente ao adicionar o plugin Postgres (${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# Token simples para proteger a API (sem login). Gere um valor aleatório qualquer,
# ex.: openssl rand -hex 32. O frontend precisa do MESMO valor em VITE_APP_ACCESS_TOKEN.
APP_ACCESS_TOKEN=

# Chave da API da Anthropic (Claude), usada pelo endpoint de rotina sugerida por IA.
# Veja instruções em README.md > "Rotina sugerida por IA".
ANTHROPIC_API_KEY=

# Porta em que o servidor Express sobe (Railway define automaticamente em produção).
PORT=3001

# --- Frontend (build) ---

# Mesmo valor de APP_ACCESS_TOKEN acima — fica embutido no build do frontend.
VITE_APP_ACCESS_TOKEN=
