generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkoutSession {
  id          String    @id @default(uuid())
  split       String
  exerciseIds String[]
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  sets        SetEntry[]

  @@map("workout_sessions")
}

model SetEntry {
  id          String         @id @default(uuid())
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  exerciseId  String
  setNumber   Int
  weightKg    Float
  reps        Int
  rpe         Int
  completedAt DateTime       @default(now())

  @@index([exerciseId])
  @@index([sessionId])
  @@map("set_entries")
}

model PersonalRecord {
  exerciseId       String   @id
  bestEstOneRepMax Float
  bestWeightKg     Float
  bestReps         Int
  achievedAt       DateTime
  sessionId        String

  @@map("personal_records")
}

/// Uso pessoal (sem login): sempre uma única linha, id fixo "me".
model UserGoals {
  id            String   @id @default("me")
  objective     String
  level         String
  daysPerWeek   Int
  equipment     String[]
  limitations   String   @default("")
  updatedAt     DateTime @updatedAt

  @@map("user_goals")
}
